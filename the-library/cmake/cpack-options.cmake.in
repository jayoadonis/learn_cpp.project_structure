#REM: This file evaluates at CPack-time, extracting the active dynamic configuration!
if(CPACK_BUILD_CONFIG)
    set(_classifier "${CPACK_BUILD_CONFIG}")
else()
    set(_classifier "Release")
endif()

set(_raw_filename "${CPACK_PACKAGE_NAME}-${CPACK_PACKAGE_VERSION}-${_classifier}-@CMAKE_SYSTEM_NAME@-@CMAKE_SYSTEM_PROCESSOR@")

string(TOLOWER "${_raw_filename}" _lowercase_filename)

set(CPACK_PACKAGE_FILE_NAME "${_lowercase_filename}")
